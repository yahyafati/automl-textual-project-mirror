{
  "runtime_id": "<RUNTIME ID>",
  "device": "auto",
  "dataset": "<DATASET NAME>",
  "output_path": "results/<DATASET NAME>/<RUNTIME ID>",
  "load_path": null,
  "data_path": "data",
  "seed": 67,
  "approach": "sequence-dl",
  "evaluation_budget": 30,
  "max_budget": 10,
  "min_budget": 3,
  "n_trials": 20,
  "max_trial_time_seconds": 600,
  "enable_jsonl_history": true,
  "evaluate_incumbent": false,
  "max_num_rows": 20000,
  "val_size": 0.1,
  "optimizer": "<VARIABLE>", /* ifbo | random | smac */
  "num_workers": 4,
  "num_parallel_trials": 1,
  "stochastic_epochs": true,
  "stochastic_epoch_fraction": 0.5,
  "log_level": "DEBUG",
  "ifbo_use_random_selection": "<VARIABLE>",/* true with ifbo as optimizer will not do curve prediction (ifbo-random) */
  "ifbo_greedy_candidate_selection": true,
  "ifbo_incumbent_ensemble_top_k": 1,
  "ifbo_incumbent_ensemble_accuracy_threshold": 0.1,
  "ifbo_thaw_step": 1,
  "ifbo_incumbent_exclusion_min_observations": 2,
  "max_trainers_in_memory": 2
}