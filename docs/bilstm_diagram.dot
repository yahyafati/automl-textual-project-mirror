digraph BiLSTM {
    rankdir=LR;
    fontname="Helvetica";
    labelloc="t";
    label=<<b>sequence-dl — BiLSTMClassifier</b><br/><font point-size="11">automl/core/approaches/sequence_dl.py</font>>;
    fontsize=20;
    bgcolor="white";
    node [fontname="Helvetica", fontsize=13, style="filled,rounded", shape=box, penwidth=1.3, margin="0.2,0.12"];
    edge [fontname="Helvetica", fontsize=11, color="#555555", penwidth=1.1];

    input [label="input_ids", shape=oval, fillcolor="#E8EAF6", color="#3F51B5"];
    embed [label="Embedding\n(pretrained warm-start)", fillcolor="#E0F2F1", color="#00695C"];
    lstm [label="Bidirectional LSTM\n(seq_num_layers × hidden_dim)", fillcolor="#D1C4E9", color="#4527A0", shape=box3d];
    attn [label="Attention pooling\n(masked, over all timesteps)", fillcolor="#FCE4EC", color="#C2185B"];
    dropout [label="Dropout", fillcolor="#ECEFF1", color="#455A64"];
    fc [label="Linear", fillcolor="#FFCCBC", color="#BF360C"];
    output [label="logits", shape=oval, fillcolor="#E8EAF6", color="#3F51B5"];

    input -> embed -> lstm -> attn -> dropout -> fc -> output;
}
