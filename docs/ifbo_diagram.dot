digraph ifBO {
    rankdir=TB;
    fontname="Helvetica";
    labelloc="t";
    label=<<b>ifBO — In-Context Freeze-Thaw Bayesian Optimization</b><br/><font point-size="11">automl/core/optimizers/ifbo/optimizer.py</font>>;
    fontsize=20;
    bgcolor="white";
    node [fontname="Helvetica", fontsize=13, style="filled,rounded", shape=box, penwidth=1.3, margin="0.25,0.15"];
    edge [fontname="Helvetica", fontsize=11, color="#555555", penwidth=1.1];

    start [label="Start (pool = ∅)", shape=oval, fillcolor="#E8EAF6", color="#3F51B5"];
    space [label="Search space Λ\n(BiLSTM hyperparameters)", shape=oval, fillcolor="#E8EAF6", color="#3F51B5"];
    pool [label="Candidate pool\npartial learning curves (freeze-thaw history H)", fillcolor="#E0F2F1", color="#00695C"];
    gate [label="ε-greedy gate\nexplore vs. exploit, ε decays over the run", shape=diamond, fillcolor="#FCE4EC", color="#C2185B"];
    explore [label="EXPLORE (prob ε)\nsample a brand-new config from Λ", fillcolor="#E1F5FE", color="#0277BD"];
    surrogate [label="FT-PFN surrogate\npretrained, frozen — in-context prediction", fillcolor="#D1C4E9", color="#4527A0", shape=box3d];
    acquisition [label="MFPI-random acquisition\n(prob 1−ε) pick the best existing candidate to thaw", fillcolor="#F3E5F5", color="#7B1FA2"];
    train [label="Train one more step\ncheckpointed BiLSTM training, new curve point recorded", fillcolor="#B2DFDB", color="#00695C"];
    budget_check [label="budget exhausted?", shape=diamond, fillcolor="#FFF9C4", color="#F9A825"];
    output [label="Incumbent ensemble → majority vote\n→ predictions.npy", fillcolor="#FFCCBC", color="#BF360C"];

    start -> gate;
    space -> explore [label="  sample"];
    pool -> surrogate [label="  context"];
    gate -> explore [label="  ε"];
    gate -> surrogate [label="  1−ε"];
    surrogate -> acquisition [label="  predicted curves"];
    explore -> train;
    acquisition -> train [label="  selected config"];
    train -> pool [label="  new observation", constraint=false];
    train -> budget_check;
    budget_check -> gate [label="no, keep going", constraint=false, style=dashed, color="#9E9E9E"];
    budget_check -> output [label="yes"];
}
